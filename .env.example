# Copy to .env for local runs (npm start). On Vercel, add the same keys in
# Project -> Settings -> Environment Variables. NEVER commit real values.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "service_role" secret (NOT the anon key). Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay: Dashboard -> Account & Settings -> API Keys (rzp_test_... for testing, rzp_live_... for real)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay: Dashboard -> Webhooks -> the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Admin panel login password (min 8 chars, use a strong one)
ADMIN_PASSWORD=
# Random string, min 32 chars (signs admin sessions). Changing it logs everyone out.
ADMIN_SESSION_SECRET=

# Random string; Vercel Cron sends it to /api/cron automatically when set
CRON_SECRET=
