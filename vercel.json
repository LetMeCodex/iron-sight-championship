{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/scores",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=5, stale-while-revalidate=10"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
